        int n = nums.length;

        int[] change = new int[n];

        for (int i = 0; i < n; i++) {
            int start = (i - nums[i] + 1 + n) % n;
            int end = (i + 1) % n;

            change[start]--;
            change[end]++;

            if (start > end) {
                change[0]--;
            }
        }

        int bestK = 0;
        int score = 0;
        int maxScore = 0;

        for (int k = 1; k < n; k++) {
            score += change[k];

            if (score > maxScore) {
                maxScore = score;
                bestK = k;
            }
        }

        return bestK;
    }
}
class Solution {
    public double champagneTower(int poured, int query_row, int query_glass) {
        double[][] tower = new double[102][102];
        tower[0][0] = (double) poured;

        for (int r = 0; r <= query_row; r++) {
            for (int c = 0; c <= r; c++) {
                if (tower[r][c] > 1.0) {
                    double excess = (tower[r][c] - 1.0) / 2.0;
                    tower[r][c] = 1.0;
                    tower[r + 1][c] += excess;
                    tower[r + 1][c + 1] += excess;
                }
            }
        }
        return tower[query_row][query_glass];
    }
}
public int minSwap(int[] nums1, int[] nums2) {


    public Fenvick(int n){
        this.n=n;
        bit=new int[n+1];
    }
    public void update(int i,int val){
        while(i<=n){
            bit[i]+=val;
            i+=(i&(-i));
        }
    }
    public int sum(int i){
        int s=0;
        while(i>0){
            s+=bit[i];
            i-=(i&(-i));
        }
        return s;
    }
}

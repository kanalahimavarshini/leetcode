class Solution {
    public String crackSafe(int n, int k) {
        int t = (int) Math.pow(k, n-1);
        int[] seen = new int[t];

        StringBuilder s = new StringBuilder();
    
        Runnable dfs = new Runnable() {
            
        void bldSeq(int u) {
            while (seen[u] < k) {
                int d = seen[u]++;
                bldSeq((u * k + d) % t);

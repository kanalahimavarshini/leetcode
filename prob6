class MyCalendarThree {
    Node root;
    public MyCalendarThree() {
        root = new Node(0,0,(int)1e9 - 1);
    }
    
    public int book(int st, int end) {
        updateTree(root,st,end - 1);
        return root.result;
    }
    private void updateTree(Node node,int left,int right){
        int l = node.left,h = node.right;
        int mid = (h - l) / 2 + l;
        if(l > right || h < left) return;
        if(l >= left && h <= right){
            node.result++;
            node.lazy++;
            return;
        }
        push(node);
        updateTree(node.leftNode,left,right);
        updateTree(node.rightNode,left,right);
        node.result = Math.max(node.leftNode.result,node.rightNode.result); 
    }
    private void push(Node node){
        int l = node.left,h = node.right;
        int mid = (h - l) / 2 + l;
        if(node.leftNode == null){
            node.leftNode = new Node(0,l,mid);
        }
        if(node.rightNode == null){
            node.rightNode = new Node(0,mid + 1,h);
        }
        if(node.lazy == 0)return;
        node.leftNode.result += node.lazy;
        node.rightNode.result += node.lazy;
        node.leftNode.lazy += node.lazy;
        node.rightNode.lazy += node.lazy;
        node.lazy = 0;
    }
}
class Solution {
    public int[][] floodFill(int[][] image, int sr, int sc, int color) {
        int originalColor = image[sr][sc];

        // Base case: if target color is same as starting color, return directly
        if (originalColor == color) return image;

        dfs(image, sr, sc, originalColor, color);

        return image;
    }

    void dfs(int[][] image, int sr, int sc, int originalColor, int givenColor) {
        int m = image.length;
        int n = image[0].length;

        // Boundary checks and color match check
        if (sr < 0 || sr >= m || sc < 0 || sc >= n) return;
        if (image[sr][sc] != originalColor) return;

        // Update color
        image[sr][sc] = givenColor;

        // Recurse on adjacent pixels using originalColor
        dfs(image, sr + 1, sc, originalColor, givenColor);
        dfs(image, sr - 1, sc, originalColor, givenColor);
        dfs(image, sr, sc + 1, originalColor, givenColor);
        dfs(image, sr, sc - 1, originalColor, givenColor);
    }

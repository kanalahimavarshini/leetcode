    class Solution {

    int count = 0;

    private void explore(TreeNode r, long sum, int target) {
        if (r == null) return;

        sum += r.val;

        if (sum == target) {
            count++;
        }

        explore(r.left, sum, target);
        explore(r.right, sum, target);
    }

    private void findPath(TreeNode r, int target) {
        if (r == null) return;

        // Consider the current node as the starting point
        explore(r, 0, target);

        // Find paths starting from other nodes
        findPath(r.left, target);
        findPath(r.right, target);
    }

    public int pathSum(TreeNode root, int targetSum) {
        count = 0;
        findPath(root, targetSum);
        return count;
    }
}
class Solution {
    public List<Integer> findAnagrams(String s, String p) {
        List<Integer> res = new ArrayList<>();
        
        int n = s.length();
        int k = p.length();
        
        int[] pCount = new int[26];
        for (char c : p.toCharArray()) {
            pCount[c - 'a']++; // 1000
        }
        
        for (int i = 0; i <= n - k; i++) { // 9000
            int[] sCount = new int[26];
            
            for (int j = i; j <= i + k - 1; j++) { // 1000
                sCount[s.charAt(j) - 'a']++;
            }
            
            if (Arrays.equals(pCount, sCount)) {
                res.add(i);
            }
        }
        
        return res;
    }
}
class Solution {
    private int getReqNum(long a, long b, long n) {
        int gap = 0;
